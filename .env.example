# ==============================================================================
# ALUMNET (P11) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and customize secrets before starting services.
# In production, ensure ENABLE_DEMO_LOGIN=false and supply high-entropy keys.
# ==============================================================================

# Application Environment & Ports
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo Gating (Strictly blocked in production: server refuses boot if NODE_ENV=production)
ENABLE_DEMO_LOGIN=true

# Cryptographic Keys & Secrets (Must be at least 32 characters or 64 hex characters)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_random_entropy_2026
JWT_REFRESH_SECRET=super_secret_refresh_key_at_least_32_characters_random_entropy_2026
COOKIE_SECRET=super_secret_cookie_signing_string_32_chars_2026
CALENDAR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MESSAGE_ENCRYPTION_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Database & Cache Infrastructure
MONGODB_URI=mongodb://127.0.0.1:27017/alumni_mentorship
REDIS_URL=redis://127.0.0.1:6379

# File Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Structured Logging Level (error, warn, info, http, debug)
LOG_LEVEL=info

# Google Meet & Calendar Integration ('google' or 'mock')
MEET_PROVIDER=mock
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Transactional Email & Notifications ('mailpit', 'nodemailer', or 'mock')
EMAIL_DRIVER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AlumNet Mentorship <no-reply@alumni.edu>
